# ─── LLM (Remote Azure Confidential GPU) ─────────────────────────
# Point to your remote LLM endpoint.
# When using Azure Confidential GPU, the endpoint must support
# OpenAI-compatible chat completions.
LLM_API_BASE=https://YOUR-ENDPOINT.openai.azure.com/
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o
LLM_API_VERSION=2024-08-01-preview

# ─── SIX MCP Server ──────────────────────────────────────────────
SIX_MCP_SERVER_URL=
SIX_MCP_SERVER_API_KEY=

# ─── Microsoft GraphRAG ───────────────────────────────────────────
GRAPHRAG_API_URL=http://localhost:8001
GRAPHRAG_DATA_ROOT=./graphrag/data

# ─── Workbench API (existing server) ─────────────────────────────
WORKBENCH_API_URL=http://localhost:4000